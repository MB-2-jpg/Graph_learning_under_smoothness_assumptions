# decoded caches: regenerated from data_raw on first run
data/reel_graphs/*/data_interim/*
!data/reel_graphs/*/data_interim/.gitkeep

# experiment artifacts: regenerated by the run_experiments_* scripts
outputs/*/*
!outputs/*/.gitkeep
reports/*/*
!reports/*/.gitkeep

__pycache__/
*.py[cod]
.ipynb_checkpoints/
